# Whitelist: only each week's code/ folder, plus the site's landing page and GitHub Pages files, is tracked.
# Readings, slides, the syllabus and local tool settings stay out of the repo.
/*
!/.gitignore
!/.nojekyll
!/404.html
!/README.md
!/CONTEXT.md
!/index.html
# Eleventy build (spike/eleventy). node_modules/ and _site/ stay ignored by /*.
!/package.json
!/package-lock.json
!/eleventy.config.js
!/previews.11ty.js
!/_config/
!/_includes/
!/concepts/
!/spike/
!/SPIKE.md
!/week-*/
/week-*/*
!/week-*/code/

__pycache__/
*.pyc
.DS_Store
