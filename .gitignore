# Whitelist: only each week's code/ folder, plus the landing page, GitHub Pages files, the glossary and docs/, is tracked.
# Readings, slides, the syllabus and local tool settings stay out of the repo.
/*
!/.gitignore
!/.nojekyll
!/404.html
!/README.md
!/CONTEXT.md
!/docs/
!/index.html
!/week-*/
/week-*/*
!/week-*/code/

__pycache__/
*.pyc
.DS_Store
