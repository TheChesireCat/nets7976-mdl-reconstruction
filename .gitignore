# Whitelist: only each week's code/ folder, plus the landing page, GitHub Pages files, the glossary and docs/, is tracked.
# Readings, slides, the syllabus and local tool settings stay out of the repo.
/*
!/.gitignore
!/.nojekyll
!/404.html
!/README.md
!/CONTEXT.md
!/docs/
!/index.html
!/week-*/
/week-*/*
!/week-*/code/

__pycache__/
*.pyc
.DS_Store

# Build (Eleventy): sources tracked, output and dependencies not.
!/package.json
!/package-lock.json
!/.nvmrc
!/eleventy.config.js
!/_config/
!/.github/
!/404.11ty.js
!/index.11ty.js
!/previews.11ty.js
!/_includes/
!/concepts/
!/data/
!/scripts/
node_modules/
_site/
